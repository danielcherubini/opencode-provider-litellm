# LiteLLM proxy connection (required — env vars take precedence over plugin options)
LITELLM_URL=https://your-litellm-proxy.example.com
LITELLM_KEY=sk-your-api-key

# Provider name in OpenCode (default: LiteLLM)
#LITELLM_PROVIDER_ID=LiteLLM

# Google ADC auth instead of an API key (makes LITELLM_KEY optional)
#LITELLM_GCLOUD_TOKEN_AUTH=1
#GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# E2E tests (scripts/e2e-proxy.mjs and RUN_E2E=1 vitest runs).
# Comma-separated exact model IDs — live prompts are sent ONLY to these.
#E2E_TEST_MODELS=my-model-a,my-model-b
#E2E_REASONING_EFFORT=high
